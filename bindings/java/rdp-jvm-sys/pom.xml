<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.scorpio-datalake.rust-data-processing</groupId>
  <artifactId>rdp-jvm-sys</artifactId>
  <version>0.3.5</version>
  <packaging>pom</packaging>
  <name>rdp-jvm-sys (native classifiers)</name>
  <description>Prebuilt rdp_jvm_sys shared libraries per OS/CPU for Panama FFM. Classifier JARs contain META-INF/native/ only — not a fat JAR.</description>
  <url>https://github.com/scorpio-datalake/rust-data-processing</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>scorpio-datalake</name>
      <organization>scorpio-datalake</organization>
      <organizationUrl>https://github.com/scorpio-datalake</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/scorpio-datalake/rust-data-processing.git</connection>
    <developerConnection>scm:git:ssh://github.com:scorpio-datalake/rust-data-processing.git</developerConnection>
    <url>https://github.com/scorpio-datalake/rust-data-processing</url>
    <tag>v${project.version}</tag>
  </scm>

  <profiles>
    <!-- Attach prebuilt classifier JARs when -Drdp.native.jar.<classifier>=/path is set (CI deploy script). -->
    <profile>
      <id>native-jar-linux-x86_64</id>
      <activation>
        <property><name>rdp.native.jar.linux-x86_64</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>attach-native-jar</id>
                <phase>package</phase>
                <goals><goal>attach-artifact</goal></goals>
                <configuration>
                  <file>${rdp.native.jar.linux-x86_64}</file>
                  <classifier>linux-x86_64</classifier>
                  <type>jar</type>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native-jar-linux-aarch64</id>
      <activation>
        <property><name>rdp.native.jar.linux-aarch64</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>attach-native-jar</id>
                <phase>package</phase>
                <goals><goal>attach-artifact</goal></goals>
                <configuration>
                  <file>${rdp.native.jar.linux-aarch64}</file>
                  <classifier>linux-aarch64</classifier>
                  <type>jar</type>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native-jar-osx-aarch64</id>
      <activation>
        <property><name>rdp.native.jar.osx-aarch64</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>attach-native-jar</id>
                <phase>package</phase>
                <goals><goal>attach-artifact</goal></goals>
                <configuration>
                  <file>${rdp.native.jar.osx-aarch64}</file>
                  <classifier>osx-aarch64</classifier>
                  <type>jar</type>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native-jar-osx-x86_64</id>
      <activation>
        <property><name>rdp.native.jar.osx-x86_64</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>attach-native-jar</id>
                <phase>package</phase>
                <goals><goal>attach-artifact</goal></goals>
                <configuration>
                  <file>${rdp.native.jar.osx-x86_64}</file>
                  <classifier>osx-x86_64</classifier>
                  <type>jar</type>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native-jar-windows-x86_64</id>
      <activation>
        <property><name>rdp.native.jar.windows-x86_64</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>attach-native-jar</id>
                <phase>package</phase>
                <goals><goal>attach-artifact</goal></goals>
                <configuration>
                  <file>${rdp.native.jar.windows-x86_64}</file>
                  <classifier>windows-x86_64</classifier>
                  <type>jar</type>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- CI: mvn -Pcentral-release deploy with -Drdp.native.jar.* properties -->
    <profile>
      <id>central-release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.10.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <deploymentName>rdp-jvm-sys-${project.version}</deploymentName>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
