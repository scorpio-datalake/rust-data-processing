<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.rust_data_processing</groupId>
  <artifactId>rust-data-processing-jvm-spark</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>rust-data-processing JVM ↔ Spark</name>
  <description>
    Materializes RDP JSON envelopes (tabular JSON DataSet, temp Parquet, Polars Parquet handoff,
    or temp Arrow IPC) into Spark DataFrames without callers managing temp paths. Depends on
    rust-data-processing-jvm, Spark SQL, and Apache Arrow Java (IPC file read).
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <spark.version>3.5.4</spark.version>
    <scala.binary.version>2.13</scala.binary.version>
    <!-- Align with Spark 3.5.x Arrow stack for IPC file reads. -->
    <arrow.version>15.0.2</arrow.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.rust_data_processing</groupId>
      <artifactId>rust-data-processing-jvm</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_${scala.binary.version}</artifactId>
      <version>${spark.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-vector</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-ipc</artifactId>
      <version>${arrow.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>io.github.rust_data_processing.examples.SparkMaterializeExample</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
