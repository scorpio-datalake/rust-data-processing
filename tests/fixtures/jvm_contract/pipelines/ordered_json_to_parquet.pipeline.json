  "pipeline_spec_version": 1,
  "sources": {
    "paths": ["{{SOURCE_PATH_A}}", "{{SOURCE_PATH_B}}"],
    "schema_ref": "schemas/id_name.schema.json",
    "options": { "format": "json" }
  },
